<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gameluck.promotion.mapper.PromotionRewardMapper">

    <select id="selectByIdForUpdate" resultType="com.gameluck.promotion.domain.PromotionReward">
        SELECT *
        FROM gl_promotion_reward
        WHERE id = #{id}
          AND del_flag = '0'
        FOR UPDATE
    </select>

</mapper>
