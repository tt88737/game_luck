<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.gameluck.redemption.mapper.RedemptionOrderMapper">

    <select id="selectByIdForUpdate" resultType="com.gameluck.redemption.domain.RedemptionOrder">
        SELECT *
        FROM gl_redemption_order
        WHERE id = #{id}
          AND del_flag = '0'
        FOR UPDATE
    </select>

</mapper>
